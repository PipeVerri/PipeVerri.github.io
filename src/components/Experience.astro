---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const accent = siteConfig.accentColor;
---

{hasExperience && siteConfig.experience.map((exp, expIndex) => (
  <div
    id={expIndex === 0 ? "experience" : `experience-${expIndex}`}
    class="slide flex items-center px-8 sm:px-12 md:px-16 lg:px-24 py-16 bg-white section"
  >
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

      {/* Left: heading + tabs */}
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Experience
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />

        <nav class="mt-8 flex flex-col gap-1">
          {siteConfig.experience.map((e, i) => (
            <a
              href={i === 0 ? "#experience" : `#experience-${i}`}
              class="block text-left px-4 py-3 rounded-lg font-mono text-sm font-medium border no-underline"
              style={{
                backgroundColor: i === expIndex ? `${accent}1a` : "",
                borderColor: i === expIndex ? `${accent}40` : "transparent",
                color: i === expIndex ? accent : "#6b7280",
              }}
            >
              <span class="text-xs mr-2 opacity-60">0{i + 1}</span>
              {e.company}
            </a>
          ))}
        </nav>
      </div>

      {/* Right: content */}
      <div
        class="lg:col-span-8 overflow-y-auto"
        style="height: 72vh; height: 72dvh;"
      >
        <div class="pr-2">
          <div class="bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 p-4 sm:p-6 md:p-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
              <div>
                <span class="text-xs font-mono" style={{ color: accent }}>0{expIndex + 1}</span>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">{exp.title}</h3>
                <p class="text-base sm:text-lg font-medium mt-1" style={{ color: accent }}>{exp.company}</p>
              </div>
              <span class="text-xs sm:text-sm text-gray-500 font-mono mt-2 sm:mt-0">{exp.dateRange}</span>
            </div>
            <ul class="space-y-3">
              {exp.bullets.map((bullet) => (
                <li class="flex items-start">
                  <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0" style={{ backgroundColor: accent }} />
                  <span class="text-sm sm:text-base text-gray-600 leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
))}
