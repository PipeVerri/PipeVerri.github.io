---
import { siteConfig } from "../config";
const hasWorkTopics = siteConfig.workTopics && siteConfig.workTopics.length > 0;
const accent = siteConfig.accentColor;
---

{hasWorkTopics && (
  <div id="my-work" class="slide flex items-start bg-white section fp-noscroll overflow-visible h-screen" style="height: auto; min-height: 100vh; overflow: visible;">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start h-full px-8 sm:px-12 md:px-16 lg:px-24 py-16">

      {/* Left: heading + tabs */}
      <div class="lg:col-span-4 sticky top-0 h-screen flex flex-col">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          My Work
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />

        <nav class="mt-8 flex flex-col gap-1" id="work-tabs">
          {siteConfig.workTopics.map((topic, i) => (
            <button
              class="work-tab text-left px-4 py-3 rounded-lg font-mono text-sm font-medium border border-transparent"
              data-index={i}
              data-accent={accent}
              style={{
                backgroundColor: i === 0 ? `${accent}1a` : "",
                borderColor: i === 0 ? `${accent}40` : "transparent",
                color: i === 0 ? accent : "#6b7280",
              }}
            >
              <span class="text-xs mr-2 opacity-60">0{i + 1}</span>
              <span class="font-bold">{topic.name}</span>
            </button>
          ))}
        </nav>
      </div>

      {/* Right: panels */}
      <div class="lg:col-span-8" style="overflow: visible;">
      <div id="work-right-panel" class="overflow-y-auto" style="height: calc(100vh - 8rem); padding: 20px 28px 28px 20px;">
        <div id="work-panels-wrapper" style="position: relative;">
        {siteConfig.workTopics.map((topic, topicIndex) => (
          <div
            class="work-panel"
            data-index={topicIndex}
            style={{ display: topicIndex === 0 ? "block" : "none" }}
          >
            <div class="space-y-12">

              {topic.lists && Object.entries(topic.lists).map(([listName, list]) => (
                list.items && list.items.length > 0 && (
                  <div>
                    <h3 class="text-lg font-bold font-mono mb-4 pb-2 border-b border-gray-200" style={{ color: accent }}>
                      {listName}
                    </h3>
                    <div class="space-y-6">
                      {list.items.map((item, index) => {
                        const hasModal = !!(item as any).detailedDescription;
                        const isLink = !hasModal && !!item.link;
                        const Component = isLink ? "a" : hasModal ? "button" : "div";
                        const extraProps = isLink
                          ? { href: item.link!, target: "_blank", rel: "noopener noreferrer" }
                          : hasModal
                            ? {
                                "data-open-modal": "",
                                "data-project": JSON.stringify({
                                  name: item.name,
                                  description: item.description,
                                  detailedDescription: (item as any).detailedDescription,
                                  link: item.link ?? null,
                                  image: (item as any).image ?? null,
                                  skills: (item as any).skills ?? [],
                                }),
                              }
                            : {};
                        const isInteractive = hasModal || isLink;
                        return (
                          <div class="group relative">
                            <Component
                              {...extraProps}
                              class={`w-full text-left block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                                isInteractive ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1 cursor-pointer" : ""
                              }`}
                            >
                              {isInteractive && (
                                <div class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                                  {hasModal ? (
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                  ) : list.icon === "certificate" ? (
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                    </svg>
                                  ) : (
                                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                                    </svg>
                                  )}
                                </div>
                              )}
                              <div class="space-y-3">
                                <div class="flex flex-row gap-4">
                                  {(item as any).image && (
                                    <img src={(item as any).image} alt={item.name} class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover flex-shrink-0 border border-gray-200" />
                                  )}
                                  <div>
                                    {item.year
                                      ? <span class="text-xs font-mono text-gray-600">{item.year}</span>
                                      : <span class="text-xs font-mono" style={{color: accent}}>0{index + 1}</span>
                                    }
                                    <h4 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">{item.name}</h4>
                                  </div>
                                </div>
                                <p class={`text-base sm:text-lg text-gray-600 leading-relaxed ${isInteractive ? "pr-12 sm:pr-14 md:pr-16" : ""}`}>
                                  {item.description}
                                </p>
                                {(item as any).skills && (item as any).skills.length > 0 && (
                                  <div class="flex flex-wrap gap-1.5 pt-1">
                                    {(item as any).skills.map((skill: string) => (
                                      <span class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${isInteractive ? "group-hover:bg-gray-800" : ""}`}>
                                        {skill}
                                      </span>
                                    ))}
                                  </div>
                                )}
                              </div>
                            </Component>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )
              ))}

            </div>
          </div>
        ))}
        </div>
      </div>
      </div>

    </div>
  </div>
)}

<!-- Project Modal -->
<div id="work-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6" data-accent={accent}>
  <div id="work-modal-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto z-10">
    <div class="p-6 sm:p-8">

      <div class="flex items-start justify-between mb-1">
        <div class="flex items-center gap-4">
          <div id="work-modal-image-wrap" class="hidden">
            <img id="work-modal-image" src="" alt="" class="w-16 h-16 rounded-xl object-cover border border-gray-200" />
          </div>
          <h3 id="work-modal-name" class="text-2xl sm:text-3xl font-bold text-gray-900"></h3>
        </div>
        <button id="work-modal-close" class="ml-4 flex-shrink-0 w-9 h-9 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded-full transition-colors">
          <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="work-modal-accent-bar" class="w-[50px] h-[4px] mb-5 rounded-full"></div>

      <div id="work-modal-description" class="text-gray-700 leading-relaxed mb-6 text-base font-sans space-y-3"></div>

      <div id="work-modal-skills-wrap" class="mb-6 hidden">
        <p class="text-xs font-mono font-semibold text-gray-400 mb-2 tracking-widest">STACK</p>
        <div id="work-modal-skills" class="flex flex-wrap gap-2"></div>
      </div>

      <div id="work-modal-link-wrap" class="hidden">
        <a
          id="work-modal-link"
          href=""
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 text-white rounded-lg font-medium text-sm hover:bg-gray-700 transition-colors"
        >
          See more
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  const tabs = document.querySelectorAll(".work-tab");
  const panels = document.querySelectorAll(".work-panel");
  const rightPanel = document.getElementById("work-right-panel") as HTMLElement | null;
  const wrapper = document.getElementById("work-panels-wrapper") as HTMLElement | null;
  const accent = (tabs[0] as HTMLElement)?.dataset.accent ?? "#000000";
  let currentTab = 0;
  const totalTabs = tabs.length;
  let isTransitioning = false;

  panels.forEach((p, i) => {
    if (i !== 0) (p as HTMLElement).style.display = "none";
  });

  function goToTab(index: number, scrollToBottom = false) {
    const direction = index > currentTab ? 1 : -1;
    const outPanel = panels[currentTab] as HTMLElement;
    const newPanel = panels[index] as HTMLElement;
    currentTab = index;

    // Animate tab buttons
    tabs.forEach((t, i) => {
      const el = t as HTMLElement;
      const active = i === index;
      gsap.to(el, { color: active ? accent : "#6b7280", duration: 0.25, ease: "power2.out" });
      el.style.backgroundColor = active ? `${accent}1a` : "";
      el.style.borderColor = active ? `${accent}40` : "transparent";
    });

    const slideHeight = rightPanel?.clientHeight ?? 600;
    const scrollBefore = rightPanel?.scrollTop ?? 0;

    // Reset scroll and compensate visually with y offset on the outgoing panel
    if (rightPanel) rightPanel.scrollTop = 0;

    // Fix wrapper height and clip during animation
    if (wrapper) {
      wrapper.style.height = slideHeight + "px";
      wrapper.style.overflow = "hidden";
    }

    // outPanel starts at its scrolled visual position, newPanel starts off-screen
    gsap.set(outPanel, { position: "absolute", top: 0, left: 0, right: 0, y: -scrollBefore });
    gsap.set(newPanel, { display: "block", position: "absolute", top: 0, left: 0, right: 0, y: direction * slideHeight });

    gsap.timeline({
      onComplete: () => {
        outPanel.style.display = "none";
        gsap.set([outPanel, newPanel], { clearProps: "position,top,left,right,y" });
        if (wrapper) {
          wrapper.style.height = "";
          wrapper.style.overflow = "";
        }
        if (rightPanel) {
          rightPanel.scrollTop = scrollToBottom ? rightPanel.scrollHeight : 0;
        }
      },
    })
      .to(outPanel, { y: -scrollBefore + direction * -slideHeight, duration: 0.38, ease: "power2.inOut" }, 0)
      .to(newPanel, { y: 0, duration: 0.38, ease: "power2.inOut" }, 0);
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (isTransitioning) return;
      goToTab(parseInt((tab as HTMLElement).dataset.index ?? "0"));
    });
  });

  const OVERSCROLL_THRESHOLD = 200;
  let overscrollAccum = 0;

  const section = document.getElementById("my-work");
  if (section && rightPanel) {
    section.addEventListener("wheel", (e) => {
      const we = e as WheelEvent;
      if (!section.classList.contains("active")) {
        we.preventDefault();
        if (we.deltaY < 0) (window as any).fullpage_api?.moveSectionUp();
        else (window as any).fullpage_api?.moveSectionDown();
        return;
      }
      we.preventDefault();

      if (isTransitioning) return;

      let delta = we.deltaY;
      if (we.deltaMode === 1) delta *= 16;
      if (we.deltaMode === 2) delta *= rightPanel.clientHeight;

      const atTop = rightPanel.scrollTop <= 0;
      const atBottom = rightPanel.scrollTop + rightPanel.clientHeight >= rightPanel.scrollHeight - 1;
      const scrollingDown = delta > 0;
      const scrollingUp = delta < 0;

      if (scrollingDown && atBottom) {
        overscrollAccum += delta;
        if (overscrollAccum >= OVERSCROLL_THRESHOLD) {
          overscrollAccum = 0;
          isTransitioning = true;
          if (currentTab < totalTabs - 1) {
            goToTab(currentTab + 1, false);
          } else {
            // @ts-ignore
            fullpage_api.moveSectionDown();
          }
          setTimeout(() => { isTransitioning = false; }, 800);
        }
      } else if (scrollingUp && atTop) {
        overscrollAccum += delta;
        if (overscrollAccum <= -OVERSCROLL_THRESHOLD) {
          overscrollAccum = 0;
          isTransitioning = true;
          if (currentTab > 0) {
            goToTab(currentTab - 1, false);
          } else {
            // @ts-ignore
            fullpage_api.moveSectionUp();
          }
          setTimeout(() => { isTransitioning = false; }, 800);
        }
      } else {
        overscrollAccum = 0;
        rightPanel.scrollTop += delta;
      }
    }, { passive: false });
  }

  // Modal — move outside fullpage to avoid CSS transform interference with position:fixed
  const modal = document.getElementById("work-modal");
  document.body.appendChild(modal);
  const accentBar = document.getElementById("work-modal-accent-bar");
  accentBar.style.backgroundColor = accent;

  function inlineMarkdown(text) {
    return text
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/\*(.+?)\*/g, "<em>$1</em>")
        .replace(/_(.+?)_/g, "<em>$1</em>")
        .replace(/`(.+?)`/g, '<code class="bg-gray-100 px-1 rounded text-sm font-mono">$1</code>');
  }

  function renderMarkdown(text) {
    const lines = text.split("\n");
    let html = "";
    let inList = false;

    for (const line of lines) {
      if (line.startsWith("### ")) {
        if (inList) { html += "</ul>"; inList = false; }
        html += `<h5 class="font-semibold text-gray-900 mt-3 mb-1">${inlineMarkdown(line.slice(4))}</h5>`;
      } else if (line.startsWith("## ")) {
        if (inList) { html += "</ul>"; inList = false; }
        html += `<h4 class="font-bold text-gray-900 text-lg mt-4 mb-1">${inlineMarkdown(line.slice(3))}</h4>`;
      } else if (line.startsWith("# ")) {
        if (inList) { html += "</ul>"; inList = false; }
        html += `<h3 class="font-bold text-gray-900 text-xl mt-4 mb-2">${inlineMarkdown(line.slice(2))}</h3>`;
      } else if (/^[-*] /.test(line)) {
        if (!inList) { html += '<ul class="list-disc list-inside space-y-1 pl-1">'; inList = true; }
        html += `<li>${inlineMarkdown(line.slice(2))}</li>`;
      } else if (line.trim() === "") {
        if (inList) { html += "</ul>"; inList = false; }
      } else {
        if (inList) { html += "</ul>"; inList = false; }
        html += `<p>${inlineMarkdown(line)}</p>`;
      }
    }

    if (inList) html += "</ul>";
    return html;
  }

  function openModal(project) {
    document.getElementById("work-modal-name").textContent = project.name;

    const descEl = document.getElementById("work-modal-description");
    descEl.innerHTML = renderMarkdown(project.detailedDescription);

    const imageWrap = document.getElementById("work-modal-image-wrap");
    const imageEl = document.getElementById("work-modal-image");
    if (project.image) {
      imageEl.src = project.image;
      imageEl.alt = project.name;
      imageWrap.classList.remove("hidden");
    } else {
      imageWrap.classList.add("hidden");
    }

    const skillsWrap = document.getElementById("work-modal-skills-wrap");
    const skillsEl = document.getElementById("work-modal-skills");
    if (project.skills && project.skills.length > 0) {
      skillsEl.innerHTML = project.skills
          .map((s) => `<span class="px-3 py-1.5 bg-gray-900 text-white rounded-lg text-sm font-medium">${s}</span>`)
          .join("");
      skillsWrap.classList.remove("hidden");
    } else {
      skillsWrap.classList.add("hidden");
    }

    const linkWrap = document.getElementById("work-modal-link-wrap");
    const linkEl = document.getElementById("work-modal-link");
    if (project.link) {
      linkEl.href = project.link;
      linkWrap.classList.remove("hidden");
    } else {
      linkWrap.classList.add("hidden");
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest("[data-open-modal]");
    if (btn) {
      const data = JSON.parse((btn as HTMLElement).dataset.project || "{}");
      openModal(data);
    }
  });

  document.getElementById("work-modal-close").addEventListener("click", closeModal);
  document.getElementById("work-modal-backdrop").addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>