---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projectGroups && siteConfig.projectGroups.length > 0;
const accent = siteConfig.accentColor;
---

{hasProjects && (
  <div id="projects" class="slide flex items-center px-8 sm:px-12 md:px-16 lg:px-24 py-16 bg-white">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

      {/* Left: heading + tabs */}
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Current Projects
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />

        <nav class="mt-8 flex flex-col gap-1" id="projects-tabs">
          {siteConfig.projectGroups.map((g, i) => (
            <button
              class="projects-tab text-left px-4 py-3 rounded-lg font-mono text-sm font-medium border border-transparent"
              data-index={i}
              data-accent={accent}
              style={{
                backgroundColor: i === 0 ? `${accent}1a` : "",
                borderColor: i === 0 ? `${accent}40` : "transparent",
                color: i === 0 ? accent : "#6b7280",
              }}
            >
              <span class="text-xs mr-2 opacity-60">0{i + 1}</span>
              {g.name}
            </button>
          ))}
        </nav>
      </div>

      {/* Right: panels */}
      <div class="lg:col-span-8 relative" style="height: 72vh; height: 72dvh;">
        {siteConfig.projectGroups.map((group, groupIndex) => (
          <div
            class="projects-panel absolute inset-0 overflow-y-auto"
            data-index={groupIndex}
            style={{
              opacity: groupIndex === 0 ? "1" : "0",
              pointerEvents: groupIndex === 0 ? "auto" : "none",
              transition: "opacity 0.3s ease",
            }}
          >
            <div class="space-y-6 pr-2">
              {group.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                  : {};
                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                        project.link ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1" : ""
                      }`}
                    >
                      {project.link && (
                        <div class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                          </svg>
                        </div>
                      )}
                      <div class="space-y-3">
                        <div class="flex flex-row gap-4">
                          {project.image && (
                            <img src={project.image} alt={project.name} class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover flex-shrink-0 border border-gray-200" />
                          )}
                          <div>
                            <span class="text-xs font-mono" style={{ color: accent }}>0{index + 1}</span>
                            <h4 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">{project.name}</h4>
                          </div>
                        </div>
                        <p class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}>
                          {project.description}
                        </p>
                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 pt-1">
                            {project.skills.map((skill) => (
                              <span class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${project.link ? "group-hover:bg-gray-800" : ""}`}>
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
)}

<script define:vars={{ accent }}>
  const tabs = document.querySelectorAll(".projects-tab");
  const panels = document.querySelectorAll(".projects-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const index = parseInt(tab.dataset.index);

      tabs.forEach((t, i) => {
        const active = i === index;
        t.style.backgroundColor = active ? `${accent}1a` : "";
        t.style.borderColor = active ? `${accent}40` : "transparent";
        t.style.color = active ? accent : "#6b7280";
      });

      panels.forEach((p, i) => {
        const active = i === index;
        p.style.opacity = active ? "1" : "0";
        p.style.pointerEvents = active ? "auto" : "none";
        if (active) p.scrollTop = 0;
      });
    });
  });
</script>
